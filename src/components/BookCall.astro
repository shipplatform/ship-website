---
import { CAL_URL } from "../consts";
---

<section class="px-6 py-16 lg:py-20">
  <div
    class="mx-auto max-w-3xl rounded-lg border border-ship-accent/20 bg-ship-accent/5 p-10 text-center"
  >
    <h2 class="font-heading text-2xl font-bold uppercase tracking-tight md:text-3xl">
      Want to talk to someone who&apos;s built this before?
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-ship-gray-400">
      Book a 30-minute discovery call. No pitch deck, no script — a working
      session on whether top-down alignment fits your org — with someone who has
      led large product-engineering teams in regulated fintech.
    </p>
    <a
      href={CAL_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex h-14 items-center justify-center rounded-sm bg-ship-accent-strong px-10 text-base font-semibold text-white transition-colors hover:bg-ship-accent-strong-hover"
      >Book a Discovery Call</a
    >
  </div>
</section>
