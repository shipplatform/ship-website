---
import { NAV_LINKS, CAL_URL, APP_LOGIN_URL } from "../consts";
---

<nav
  id="site-nav"
  data-scrolled="false"
  class="fixed left-0 right-0 top-[3.25rem] z-50 bg-transparent transition-all duration-300 data-[scrolled=true]:border-b data-[scrolled=true]:border-ship-gray-800 data-[scrolled=true]:bg-ship-black/80 data-[scrolled=true]:backdrop-blur-lg md:top-9"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a
      href="#hero"
      class="font-[family-name:var(--font-syne)] text-xl font-bold uppercase tracking-wider"
      >SHIP</a
    >

    <div class="hidden items-center gap-8 md:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-sm text-ship-gray-400 transition-colors hover:text-ship-white"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={CAL_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-ship-gray-400 transition-colors hover:text-ship-white"
        >Book a Call</a
      >
      <a
        href={APP_LOGIN_URL}
        class="text-sm text-ship-gray-400 transition-colors hover:text-ship-white"
        >Log in</a
      >
      <a
        href="#design-partners"
        class="inline-flex h-9 items-center rounded-sm bg-ship-accent-strong px-5 text-sm font-semibold text-white transition-colors hover:bg-ship-accent-strong-hover"
        >Apply as design partner</a
      >
    </div>

    <button
      type="button"
      id="nav-toggle"
      class="flex h-10 w-10 items-center justify-center md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span class="space-y-1.5" aria-hidden="true">
        <span class="block h-0.5 w-6 bg-ship-white transition-transform"></span>
        <span class="block h-0.5 w-6 bg-ship-white transition-opacity"></span>
        <span class="block h-0.5 w-6 bg-ship-white transition-transform"></span>
      </span>
    </button>
  </div>
</nav>

<div
  id="nav-mobile"
  hidden
  class="fixed inset-x-0 top-[7.25rem] z-40 border-b border-ship-gray-800 bg-ship-black/95 px-6 pb-6 pt-4 backdrop-blur-lg md:hidden"
>
  <div class="flex flex-col gap-4">
    {
      NAV_LINKS.map((link) => (
        <a
          href={link.href}
          data-nav-close
          class="text-lg text-ship-gray-300 transition-colors hover:text-ship-white"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={CAL_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-nav-close
      class="inline-flex h-12 items-center justify-center rounded-sm border border-ship-gray-700 text-base font-medium text-ship-gray-300 transition-colors hover:border-ship-gray-500 hover:text-ship-white"
      >Book a Call</a
    >
    <a
      href="#design-partners"
      data-nav-close
      class="inline-flex h-12 items-center justify-center rounded-sm bg-ship-accent-strong text-base font-semibold text-white transition-colors hover:bg-ship-accent-strong-hover"
      >Apply as design partner</a
    >
    <a
      href={APP_LOGIN_URL}
      data-nav-close
      class="pt-1 text-center text-sm text-ship-gray-500 transition-colors hover:text-ship-white"
      >Already onboarded? Log in</a
    >
  </div>
</div>

<script>
  const nav = document.getElementById("site-nav");
  const toggle = document.getElementById("nav-toggle");
  const mobile = document.getElementById("nav-mobile");

  if (nav) {
    const onScroll = () => {
      nav.dataset.scrolled = window.scrollY > 40 ? "true" : "false";
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  if (toggle && mobile) {
    const onOutsidePointer = (e: PointerEvent) => {
      const target = e.target as Node | null;
      if (!target) return;
      if (mobile.contains(target) || toggle.contains(target)) return;
      setOpen(false);
    };
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape") setOpen(false);
    };

    const setOpen = (open: boolean) => {
      mobile.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      if (open) {
        document.addEventListener("pointerdown", onOutsidePointer);
        document.addEventListener("keydown", onKeydown);
      } else {
        document.removeEventListener("pointerdown", onOutsidePointer);
        document.removeEventListener("keydown", onKeydown);
      }
    };

    toggle.addEventListener("click", () => {
      setOpen(mobile.hidden);
    });
    mobile.querySelectorAll("[data-nav-close]").forEach((el) =>
      el.addEventListener("click", () => setOpen(false)),
    );
  }
</script>
