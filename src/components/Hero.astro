---
import { TRUST_COMPANIES, APP_LOGIN_URL } from "../consts";
import { HERO_DEPLOY_LINES } from "../data";
---

<section
  id="hero"
  class="relative flex min-h-screen flex-col items-center justify-center px-6 pb-24 pt-40"
>
  <div class="mx-auto max-w-5xl text-center">
    <h1
      class="font-heading text-4xl font-bold uppercase leading-tight tracking-tight sm:text-5xl md:text-7xl lg:text-8xl"
    >
      The Chief of Staff for<br />Engineering Leadership
    </h1>

    <p
      class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ship-gray-400 md:text-xl"
    >
      They tell you how fast your team works.{" "}
      <span class="text-ship-white">
        We tell you whether your team is working on the right things.
      </span>
    </p>
    <p class="mx-auto mt-3 max-w-xl text-base font-medium text-ship-gray-300">
      SHIP starts from your company goals, reads the work your teams already
      produce — code, tickets, docs, chat — then briefs you, answers any
      question, and preps your 1:1s. Without chasing anyone.
    </p>

    <div
      class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center"
    >
      <a
        href="#design-partners"
        class="inline-flex h-14 items-center justify-center rounded-sm bg-ship-accent-strong px-8 text-base font-semibold text-white transition-colors hover:bg-ship-accent-strong-hover"
        >Apply as design partner</a
      >
      <a
        href="#how-it-works"
        class="inline-flex h-14 items-center justify-center rounded-sm border border-ship-gray-700 px-8 text-base font-medium text-ship-gray-300 transition-colors hover:border-ship-gray-500 hover:text-ship-white"
        >See How It Works</a
      >
    </div>

    <p class="mt-4 text-sm text-ship-gray-500">
      Already onboarded?{" "}
      <a
        href={APP_LOGIN_URL}
        class="text-ship-gray-400 underline-offset-2 transition-colors hover:text-ship-white hover:underline"
        >Log in</a
      >
    </p>
  </div>

  <!-- Decorative terminal: below the fold of the LCP, hidden on mobile, fixed height (no CLS) -->
  <div class="hidden w-full lg:block">
    <div
      id="hero-terminal"
      data-lines={JSON.stringify(HERO_DEPLOY_LINES)}
      class="mx-auto mt-12 min-h-[224px] max-w-xl rounded-lg border border-ship-gray-800 bg-ship-gray-900/50 p-6 font-mono text-sm backdrop-blur-sm lg:mt-16"
    >
      <div class="mb-3 flex items-center gap-2">
        <span class="h-3 w-3 rounded-full bg-ship-red/60"></span>
        <span class="h-3 w-3 rounded-full bg-ship-amber/60"></span>
        <span class="h-3 w-3 rounded-full bg-ship-green/60"></span>
        <span class="ml-2 text-xs text-ship-gray-500">ship brief</span>
      </div>
      <div class="space-y-1.5" data-terminal-body></div>
    </div>
  </div>

  <div
    class="mt-16 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-ship-gray-800 pt-8 lg:mt-20"
  >
    <span class="text-xs uppercase tracking-widest text-ship-gray-500"
      >Built by engineers from</span
    >
    {
      TRUST_COMPANIES.map((company) => (
        <span class="text-sm font-medium tracking-wide text-ship-gray-400">
          {company}
        </span>
      ))
    }
  </div>
</section>

<script>
  const el = document.getElementById("hero-terminal");
  const body = el?.querySelector<HTMLElement>("[data-terminal-body]");
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  // The terminal is `hidden lg:block` — never visible below 1024px. Skip the
  // perpetual typing animation entirely on smaller screens so it doesn't run
  // setInterval forever off-screen (wasted CPU/battery on mobile).
  const isDesktop = window.matchMedia("(min-width: 1024px)").matches;

  if (el && body && isDesktop) {
    const lines: string[] = JSON.parse(el.dataset.lines || "[]").map(
      (l: string) => l.toLowerCase(),
    );
    const statuses = lines.map((_, i) =>
      i === lines.length - 1 ? "delivered" : "linked",
    );

    const renderStatic = () => {
      body.innerHTML = lines
        .map(
          (line, i) =>
            `<div class="flex items-center gap-2"><span class="text-ship-green">✓</span><span class="text-ship-gray-400">${line}</span><span class="text-ship-green">${statuses[i]}</span></div>`,
        )
        .join("");
    };

    if (prefersReduced) {
      renderStatic();
    } else {
      let typingIndex = 0;
      const done: number[] = [];

      const draw = (typed: string) => {
        const rows = done
          .map(
            (i) =>
              `<div class="flex items-center gap-2"><span class="text-ship-green">✓</span><span class="text-ship-gray-400">${lines[i]}</span><span class="text-ship-green">${statuses[i]}</span></div>`,
          )
          .join("");
        const cursor =
          typingIndex < lines.length
            ? `<div class="flex items-center gap-2"><span class="text-ship-accent">›</span><span class="text-ship-white">${typed}<span class="animate-blink text-ship-accent">▌</span></span></div>`
            : "";
        body.innerHTML = rows + cursor;
      };

      const typeLine = () => {
        if (typingIndex >= lines.length) {
          setTimeout(() => {
            done.length = 0;
            typingIndex = 0;
            typeLine();
          }, 4000);
          return;
        }
        const full = `mapping ${lines[typingIndex]}`;
        let c = 0;
        const iv = setInterval(() => {
          c++;
          draw(full.slice(0, c));
          if (c >= full.length) {
            clearInterval(iv);
            setTimeout(() => {
              done.push(typingIndex);
              typingIndex++;
              draw("");
              typeLine();
            }, 400);
          }
        }, 35);
      };

      draw("");
      typeLine();
    }
  }
</script>
