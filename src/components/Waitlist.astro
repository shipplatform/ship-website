---
import { CAL_URL, SHIP_API_BASE } from "../consts";
import { DESIGN_PARTNER_BENEFITS, TEAM_SIZES, PRIMARY_STACKS } from "../data";
---

<section
  id="design-partners"
  class="px-6 py-24 lg:py-32"
  data-api={SHIP_API_BASE}
>
  <div class="mx-auto max-w-2xl text-center">
    <div>
      <h2
        class="font-heading text-4xl font-bold uppercase leading-tight tracking-tight md:text-5xl lg:text-6xl"
      >
        Become a<br />design partner
      </h2>
      <p class="mt-4 text-lg text-ship-gray-400">
        SHIP is in private pilot — limited slots for engineering leaders who want
        a chief of staff for their org, with direct working sessions and
        founding-partner pricing. Briefs, chat, 1:1 prep and drift — without
        another dashboard graveyard.
      </p>
    </div>

    <ul class="mt-10 space-y-4 text-left">
      {
        DESIGN_PARTNER_BENEFITS.map((benefit) => (
          <li class="rounded-lg border border-ship-gray-800 bg-ship-gray-900/30 px-5 py-4">
            <p class="font-heading text-sm font-semibold uppercase tracking-tight text-ship-white">
              {benefit.title}
            </p>
            <p class="mt-1 text-sm leading-relaxed text-ship-gray-400">
              {benefit.body}
            </p>
          </li>
        ))
      }
    </ul>

    {/* Phase: email */}
    <form id="wl-email-form" class="mt-12 flex flex-col gap-3 sm:flex-row">
      <label for="wl-email" class="sr-only">Work email</label>
      <input
        id="wl-email"
        name="email"
        type="email"
        required
        placeholder="Work email"
        class="w-full flex-1 rounded-sm border border-ship-gray-700 bg-ship-gray-900 p-4 text-base text-ship-white placeholder-ship-gray-500 outline-none transition-colors focus:border-ship-accent sm:h-14 sm:py-0"
      />
      <button
        type="submit"
        class="inline-flex h-14 w-full items-center justify-center rounded-sm bg-ship-accent-strong px-8 text-base font-semibold text-white transition-colors hover:bg-ship-accent-strong-hover disabled:opacity-60 sm:w-auto"
        >Request access</button
      >
    </form>
    <p id="wl-email-note" class="mt-3 text-xs text-ship-gray-500">
      No credit card required. Private pilot. Limited spots.
    </p>
    <p id="wl-email-error" hidden class="mt-3 text-sm text-ship-red" role="alert">
      Something went wrong submitting your application. Please try again, or email{" "}
      <a class="underline" href="mailto:hello@shipplatform.ai">hello@shipplatform.ai</a>.
    </p>

    <noscript>
      <p class="mt-3 text-sm text-ship-gray-400">
        Email us at{" "}
        <a class="text-ship-accent underline" href="mailto:hello@shipplatform.ai"
          >hello@shipplatform.ai</a
        >{" "}or{" "}
        <a
          class="text-ship-accent underline"
          href={CAL_URL}
          target="_blank"
          rel="noopener noreferrer">book a discovery call</a
        > to apply.
      </p>
    </noscript>

    {/* Phase: qualify */}
    <div id="wl-qualify" hidden class="mt-12">
      <div
        class="rounded-lg border border-ship-green/30 bg-ship-green/5 p-6"
        role="status"
        aria-live="polite"
      >
        <p class="text-lg font-semibold text-ship-green">Application received.</p>
        <p class="mt-1 text-sm text-ship-gray-400">
          We&apos;ll reply within 48 hours. Onboarding design partners in Q3 2026.
        </p>
      </div>

      <form id="wl-qualify-form" class="mt-6 space-y-3">
        <p class="text-sm text-ship-gray-400">
          Help us prepare — tell us a bit more:
        </p>
        <label for="wl-company" class="sr-only">Company name</label>
        <input
          id="wl-company"
          name="company"
          type="text"
          placeholder="Company name"
          class="h-12 w-full rounded-sm border border-ship-gray-700 bg-ship-gray-900 px-4 text-ship-white placeholder-ship-gray-500 outline-none transition-colors focus:border-ship-accent"
        />
        <label for="wl-team" class="sr-only">Team size</label>
        <select
          id="wl-team"
          name="teamSize"
          class="h-12 w-full rounded-sm border border-ship-gray-700 bg-ship-gray-900 px-4 text-ship-white outline-none transition-colors focus:border-ship-accent"
        >
          <option value="" disabled selected>Team size</option>
          {TEAM_SIZES.map((size) => <option value={size}>{size} engineers</option>)}
        </select>
        <label for="wl-stack" class="sr-only">Primary stack</label>
        <select
          id="wl-stack"
          name="primaryStack"
          class="h-12 w-full rounded-sm border border-ship-gray-700 bg-ship-gray-900 px-4 text-ship-white outline-none transition-colors focus:border-ship-accent"
        >
          <option value="">Primary stack (optional)</option>
          {PRIMARY_STACKS.map((stack) => <option value={stack}>{stack}</option>)}
        </select>
        <div class="flex gap-3">
          <button
            type="submit"
            class="inline-flex h-12 flex-1 items-center justify-center rounded-sm bg-ship-gray-800 text-sm font-semibold text-ship-white transition-colors hover:bg-ship-gray-700 disabled:opacity-60"
            >Submit</button
          >
          <button
            type="button"
            data-wl-skip
            class="inline-flex h-12 items-center justify-center rounded-sm px-6 text-sm text-ship-gray-500 transition-colors hover:text-ship-gray-300"
            >Skip</button
          >
        </div>
        <p id="wl-qualify-error" hidden class="text-sm text-ship-red" role="alert">
          Something went wrong saving those details. Please try again or click Skip.
        </p>
      </form>
    </div>

    {/* Phase: done */}
    <div
      id="wl-done"
      hidden
      class="mt-12 rounded-lg border border-ship-green/30 bg-ship-green/5 p-8"
      role="status"
      aria-live="polite"
    >
      <p class="text-xl font-semibold text-ship-green">Application received.</p>
      <p class="mt-2 text-ship-gray-400">
        We&apos;ll reply within 48 hours. Onboarding design partners in Q3 2026.
      </p>
      <a
        href={CAL_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex h-12 items-center justify-center rounded-sm border border-ship-accent/30 px-6 text-sm font-semibold text-ship-accent transition-colors hover:bg-ship-accent/10"
        >Or book a discovery call now</a
      >
    </div>

    {/* Secondary: launch-updates waitlist */}
    <div id="wl-secondary" class="mt-10 border-t border-ship-gray-800 pt-8">
      <button
        type="button"
        id="wl-secondary-toggle"
        class="text-sm text-ship-gray-500 transition-colors hover:text-ship-gray-300"
      >
        Not ready for a partnership?{" "}
        <span class="text-ship-accent">Join the waitlist for launch updates</span>
      </button>
      <div id="wl-secondary-form" hidden class="mx-auto max-w-md">
        <p class="mb-3 text-sm text-ship-gray-400">
          Launch updates only — no working partnership commitment.
        </p>
        <form class="flex flex-col gap-3 sm:flex-row">
          <label for="wl-secondary-email" class="sr-only">Work email</label>
          <input
            id="wl-secondary-email"
            name="email"
            type="email"
            required
            placeholder="Work email"
            class="w-full flex-1 rounded-sm border border-ship-gray-700 bg-ship-gray-900 p-3 text-sm text-ship-white placeholder-ship-gray-500 outline-none transition-colors focus:border-ship-accent sm:h-11 sm:py-0"
          />
          <button
            type="submit"
            class="inline-flex h-11 items-center justify-center rounded-sm border border-ship-gray-700 px-5 text-sm font-medium text-ship-gray-300 transition-colors hover:border-ship-gray-500 hover:text-ship-white disabled:opacity-60"
            >Join waitlist</button
          >
        </form>
        <p id="wl-secondary-error" hidden class="mt-3 text-sm text-ship-red" role="alert">
          Something went wrong. Please try again, or email{" "}
          <a class="underline" href="mailto:hello@shipplatform.ai">hello@shipplatform.ai</a>.
        </p>
      </div>
    </div>

    <p id="wl-secondary-done" hidden class="mt-8 text-sm text-ship-green" role="status">
      You&apos;re on the waitlist — we&apos;ll send launch updates before Q3 2026.
    </p>
  </div>
</section>

<script>
  const section = document.getElementById("design-partners");
  if (section) {
    const apiBase = (section.dataset.api || "").replace(/\/$/, "");

    async function submitWaitlist(payload: {
      email: string;
      company?: string;
      teamSize?: string;
    }) {
      if (!apiBase) return;
      const body: Record<string, string> = { email: payload.email.trim() };
      if (payload.company?.trim()) body.company = payload.company.trim();
      if (payload.teamSize?.trim()) body.teamSize = payload.teamSize.trim();
      const res = await fetch(`${apiBase}/v1/waitlist`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      if (res.ok || res.status === 409) return;
      throw new Error(`waitlist api: ${res.status}`);
    }

    const $ = <T extends HTMLElement>(id: string) =>
      document.getElementById(id) as T | null;
    const emailForm = $<HTMLFormElement>("wl-email-form");
    const emailInput = $<HTMLInputElement>("wl-email");
    const emailNote = $("wl-email-note");
    const qualify = $("wl-qualify");
    const qualifyForm = $<HTMLFormElement>("wl-qualify-form");
    const done = $("wl-done");
    const secondary = $("wl-secondary");
    const secondaryToggle = $("wl-secondary-toggle");
    const secondaryForm = $("wl-secondary-form");
    const secondaryFormEl = secondaryForm?.querySelector("form");
    const secondaryEmail = $<HTMLInputElement>("wl-secondary-email");
    const secondaryDone = $("wl-secondary-done");
    const emailError = $("wl-email-error");
    const qualifyError = $("wl-qualify-error");
    const secondaryError = $("wl-secondary-error");

    let applicantEmail = "";

    const busy = (btn: HTMLButtonElement | null, on: boolean) => {
      if (btn) btn.disabled = on;
    };

    const showError = (el: HTMLElement | null, on: boolean) => {
      if (el) el.hidden = !on;
    };

    emailForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = emailForm.querySelector("button");
      busy(btn, true);
      showError(emailError, false);
      applicantEmail = emailInput?.value || "";
      try {
        await submitWaitlist({ email: applicantEmail });
      } catch {
        // Do not advance to the "Application received" state on a failed submit.
        busy(btn, false);
        showError(emailError, true);
        return;
      }
      busy(btn, false);
      emailForm.hidden = true;
      if (emailNote) emailNote.hidden = true;
      if (qualify) qualify.hidden = false;
    });

    qualifyForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = qualifyForm.querySelector('button[type="submit"]');
      busy(btn as HTMLButtonElement, true);
      showError(qualifyError, false);
      const company = ($<HTMLInputElement>("wl-company")?.value || "").trim();
      const teamSize = $<HTMLSelectElement>("wl-team")?.value || "";
      const stack = $<HTMLSelectElement>("wl-stack")?.value || "";
      const stackNote = stack ? `Design partner — stack: ${stack}` : "Design partner";
      const sizeWithIntent = teamSize ? `${teamSize} (${stackNote})` : stackNote;
      try {
        await submitWaitlist({
          email: applicantEmail,
          company: company || undefined,
          teamSize: sizeWithIntent,
        });
      } catch {
        busy(btn as HTMLButtonElement, false);
        showError(qualifyError, true);
        return;
      }
      busy(btn as HTMLButtonElement, false);
      finishPrimary();
    });

    section.querySelector("[data-wl-skip]")?.addEventListener("click", finishPrimary);

    function finishPrimary() {
      if (qualify) qualify.hidden = true;
      if (done) done.hidden = false;
      if (secondary) secondary.hidden = true;
    }

    secondaryToggle?.addEventListener("click", () => {
      if (secondaryForm) secondaryForm.hidden = false;
      secondaryToggle.hidden = true;
    });

    secondaryFormEl?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = secondaryFormEl.querySelector("button");
      busy(btn as HTMLButtonElement, true);
      showError(secondaryError, false);
      try {
        await submitWaitlist({ email: secondaryEmail?.value || "" });
      } catch {
        busy(btn as HTMLButtonElement, false);
        showError(secondaryError, true);
        return;
      }
      busy(btn as HTMLButtonElement, false);
      if (secondary) secondary.hidden = true;
      if (secondaryDone) secondaryDone.hidden = false;
    });
  }
</script>
