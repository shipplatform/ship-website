---
import { SOCIALS } from "../consts";
const year = new Date().getFullYear();
---

<footer class="border-t border-ship-gray-800 px-6 py-12">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 md:flex-row"
  >
    <div class="flex items-center gap-6">
      <span class="font-heading text-lg font-bold uppercase tracking-wider"
        >SHIP</span
      >
    </div>

    <nav
      class="flex flex-wrap items-center gap-6 text-sm text-ship-gray-500"
      aria-label="Footer"
    >
      <a href="#pricing" class="transition-colors hover:text-ship-gray-300"
        >Pricing</a
      >
      <a href="/security" class="transition-colors hover:text-ship-gray-300"
        >Security</a
      >
      <a href="/privacy" class="transition-colors hover:text-ship-gray-300"
        >Privacy Policy</a
      >
      <a href="/terms" class="transition-colors hover:text-ship-gray-300">Terms</a>
      <a
        href={SOCIALS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-ship-gray-300">LinkedIn</a
      >
      <a
        href={SOCIALS.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-ship-gray-300">YouTube</a
      >
    </nav>

    <p class="text-xs text-ship-gray-500">
      &copy; {year} SHIP Platform. All rights reserved.
    </p>
  </div>
</footer>
